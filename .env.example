# Copie para .env (que o git ignora) e preencha. Guia: .claude/skills/publicar-instagram/references/configuracao-meta.md

# Graph API — graph.instagram.com (login do Instagram) ou graph.facebook.com (login do Facebook)
IG_GRAPH_HOST=graph.instagram.com
IG_GRAPH_VERSION=v23.0

# Uma dupla por cliente. <HANDLE> = @ em maiúsculas, símbolos trocados por _
# IG_NOMEDOCLIENTE_USER_ID=
# IG_NOMEDOCLIENTE_TOKEN=

# Hospedagem temporária da mídia (bucket PRIVADO)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=instagram-fila

# Conectar o Instagram do cliente (login do Instagram) — .claude/skills/conectar-instagram/references/conectar.md
IG_APP_ID=
IG_APP_SECRET=
IG_REDIRECT_URI=https://
# O conectar.py grava sozinho, por cliente: IG_<HANDLE>_USER_ID, _TOKEN, _TOKEN_EXPIRA, _GRAPH_HOST

# Avatares (HeyGen) — .claude/skills/avatares/references/heygen.md
HEYGEN_API_KEY=
