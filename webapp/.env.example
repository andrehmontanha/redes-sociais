# Na Vercel: Settings → Environment Variables. Localmente: copie para .env.local

# Obrigatórias para conectar contas reais (sem elas o app roda só a demonstração).
# Senha de acesso da equipe, 8+ caracteres:
ESTUDIO_SENHA=
# 32+ caracteres aleatórios (openssl rand -base64 48):
SESSAO_SEGREDO=

# App da Meta — Instagram API com login do Instagram (os IDs do app DO INSTAGRAM):
IG_APP_ID=
IG_APP_SECRET=
IG_GRAPH_VERSION=v23.0

# Opcional: URL pública fixa (senão usa o domínio de produção da Vercel):
# APP_URL=https://estudio-social.vercel.app
